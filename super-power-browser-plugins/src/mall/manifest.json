{
  "manifest_version": 3,
  "name": "zf-mall-helper",
  "version": "5.1.78",
  "homepage_url": "https://www.zhanfubrowser.com",
  "description": "店铺助手，助力店铺运营",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Mall Helper",
    "default_icon": "icons/icon48.png"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "proxy",
    "storage",
    "cookies",
    "contextMenus",
    "webRequest",
    "management",
    "notifications",
    "superbrowser",
    "bookmarks",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "alarms",
    "scripting",
    "webNavigation",
    "debugger"
  ],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "js": ["content/translate.js"],
      "matches": ["*://*.tiktok.com/*", "*://*.tokopedia.com/*"],
      "run_at": "document_end"
    },
    {
      "js": [
        "content/twoStep.js",
        "content/message.js",
        "content/dynamicIpWarning.js",
        "content/element.js",
        "content/Collection.js",
        "content/platform/siteLoginAutomation.js"
      ],
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup/*",
        "contentPage/*",
        "newtab/*",
        "assets/*",
        "js/*",
        "warning/*",
        "loading/*",
        "visitRules/*"
      ],
      "matches": ["<all_urls>"],
      "use_dynamic_url": true
    }
  ]
}

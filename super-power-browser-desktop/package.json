{
  "name": "super-power-browser-desktop",
  "version": "0.1.0",
  "description": "核心店铺浏览器客户端",
  "author": "Super Power Browser",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "start": "electron .",
    "build": "node scripts/build.cjs",
    "test:proxy": "node --test scripts/proxy-runtime.test.cjs",
    "build:win": "npm run build && electron-builder --win --x64",
    "build:mac": "npm run build && node scripts/mac-icon.cjs && electron-builder --mac --x64 --arm64"
  },
  "dependencies": {
    "@super-power-browser/ai": "file:../super-power-browser-ai",
    "adm-zip": "0.5.16",
    "https-proxy-agent": "7.0.6",
    "koffi": "2.12.3",
    "proxy-chain": "^2.5.0",
    "ssh2": "1.17.0",
    "ws": "8.18.2"
  },
  "devDependencies": {
    "electron": "35.7.5",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.superpower.browser",
    "productName": "SuperPower Browser",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "branding",
        "to": "branding"
      },
      {
        "from": "resources/web",
        "to": "web"
      },
      {
        "from": "Plugin",
        "to": "Plugin"
      }
    ],
    "asarUnpack": [
      "node_modules/koffi/**/*",
      "node_modules/@cline/**/*",
      "node_modules/@super-power-browser/ai/**/*"
    ],
    "win": {
      "icon": "branding/app.ico",
      "target": "nsis"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business",
      "icon": "branding/app.icns",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    }
  }
}

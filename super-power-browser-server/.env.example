DB_URL=jdbc:mysql://127.0.0.1:3306/super_power_browser?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
DB_USER=superpower
DB_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
APP_DATA_KEY=
PORT=8080
# Browser-reachable API origin. Use HTTPS outside local preview.
AI_PUBLIC_URL=http://127.0.0.1:8080
AI_SKILL_STORAGE=./data/ai-skills
# Explicit platform operators; tenant ownership alone does not grant publishing rights.
AI_PUBLISHER_IDS=
UPDATE_MANIFEST_URL=
KERNEL_MANIFEST_PATH=
# Production: omit KERNEL_MANIFEST_PATH; releases are managed in the database.
KERNEL_LOCAL_ROOT=
# Comma-separated immutable app_user IDs of platform publishers (not tenant owners).
KERNEL_PUBLISHER_IDS=
KERNEL_S3_BUCKET=
# Empty for AWS S3; HTTPS service endpoint for compatible providers.
KERNEL_S3_ENDPOINT=
KERNEL_S3_REGION=us-east-1
KERNEL_S3_PREFIX=kernels
KERNEL_S3_PATH_STYLE=false
KERNEL_S3_ALLOW_HTTP=false
KERNEL_URL_MINUTES=15
# Prefer workload roles. Otherwise inject these through deployment secrets.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Optional, first run only: separate platform configuration operator (never a customer account).
# No operator is created unless both values are explicitly configured.
# Password: 12-72 UTF-8 bytes, containing a letter, digit and symbol. Never commit real values.
OPS_ADMIN_USERNAME=
OPS_ADMIN_PASSWORD=
